# Publish source and documentation only. Local working files stay on this machine.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/NOTICE.md
!/run_local.py
!/requirements.txt
!/cloudbaserc.json
!/.env.example
!/docs/
!/scripts/
!/web/
!/zhihu/
!/resources/
!/functions/
!/workbuddy-agent/
!/.github/

/workbuddy-agent/*
!/workbuddy-agent/zhihu-agent/
/resources/*
!/resources/textbooks/
/resources/textbooks/*
!/resources/textbooks/README.md
!/resources/textbooks/catalog.json

# Credentials, learner accounts, conversations and local database files.
.env
.env.*
!.env.example
*.pem
*.key
*-private.*
*credentials*.json
.zhihu-sessions/
.zhihu-classroom/
.workbuddy/
.openai/
*.sqlite
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.log
mcp.local.workbuddy.json
mcp.remote.json

# Generated dependencies, copies, archives and editor files.
.venv/
.uv-cache/
node_modules/
__pycache__/
*.py[cod]
*.bak
*.zip
*.pdf
dist/
.DS_Store
Thumbs.db
~$*

# Test scratch directories, including remnants from interrupted Windows runs.
**/tests/t-*/
**/tests/probe*/
**/tests/zhihu-mcp-test-*/
**/tests/zhihu-mcp-protocol-*/
**/tests/zhihu-course-test-*/
