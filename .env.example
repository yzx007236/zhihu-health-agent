# Reference only. The applications read process environment variables;
# they do not automatically load this file.

# Cloud function -> your own MCP endpoint. Never use another installation's data.
MCP_URL=https://YOUR-MCP-HOST.example/mcp
WORKBUDDY_AGENT_ID=
WBA_SECRET_ID=
WBA_SECRET_KEY=
WORKBUDDY_ENDPOINT=workbuddyenterprise.tencentcloudapi.com

# Optional model dialogue in the cloud gateway.
LLM_PROVIDER=hunyuan
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://tokenhub.tencentmaas.com/v1
HUNYUAN_MODEL=hy-role

# MCP server persistence. Set private paths / secrets on your server.
ZHIHU_SESSION_STORE=
ZHIHU_CLASSROOM_STORE=
ZHIHU_CLASSROOM_SETUP_KEY=
# Set 0 for a private real course; 1 seeds the documented synthetic demo users.
ZHIHU_CLASSROOM_DEMO=0
# Optional PostgreSQL. Use either direct DB access or the CloudBase RPC backend.
ZHIHU_CLASSROOM_DATABASE_URL=
ZHIHU_CLASSROOM_CLOUDBASE_ENV=
ZHIHU_CLASSROOM_API_KEY=

# Optional custom resources. Leave unset to use bundled defaults.
# ZHIHU_EXPERIENCE_PATH=/absolute/path/to/experience.json
# ZHIHU_TEXTBOOK_ROOT=/absolute/path/to/textbooks
